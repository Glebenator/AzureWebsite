<%
  var statusLabels = {
    pending: 'Pending',
    ready_for_review: 'Ready for review',
    embedding_pending: 'Embedding pending',
    embedding: 'Embedding',
    publishing: 'Publishing',
    published: 'Published',
    rejected: 'Rejected',
    failed: 'Failed',
    deleted: 'Deleted'
  };
  function displayDate(value) {
    if (!value) return 'Date unavailable';
    var date = new Date(value);
    return Number.isNaN(date.getTime()) ? String(value) : new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeStyle: 'short' }).format(date);
  }
  var canPublish = ['ready_for_review', 'failed'].includes(submission.status)
    || (submission.status === 'publishing' && submission.failureCode === 'cleanup_required');
  var canReject = ['ready_for_review', 'failed'].includes(submission.status);
  var publicationActive = ['embedding_pending', 'embedding', 'publishing'].includes(submission.status);
  var canDelete = !publicationActive && submission.status !== 'deleted';
%>
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= description %>">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#faf8f2">
    <title><%= title %></title>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" href="/images/favicon-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/images/favicon-180x180.png" sizes="180x180">
    <link rel="stylesheet" href="/icons/regular/style.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/submissions.css">
  </head>
  <body class="submission-page submission-admin-page">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" aria-label="Primary">
      <a class="wordmark" href="/">Gleb Gladyshevskiy</a>
      <div class="submission-header-actions">
        <nav class="primary-nav submission-nav" aria-label="Primary navigation">
          <a class="nav-link" href="/research">Research</a>
          <a class="nav-link" href="/research/submissions">My submissions</a>
          <a class="nav-link is-active" href="/admin/submissions" aria-current="page">Admin</a>
        </nav>
        <form class="submission-logout" action="/auth/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit">Sign out</button>
        </form>
      </div>
    </header>

    <main id="main-content" class="submission-main">
      <nav class="submission-breadcrumb" aria-label="Breadcrumb">
        <a href="/admin/submissions"><i class="ph ph-arrow-left" aria-hidden="true"></i><span>Submission queue</span></a>
      </nav>

      <header class="submission-detail-header">
        <div>
          <span class="submission-status status-<%= submission.status %>"><%= statusLabels[submission.status] || submission.status %></span>
          <h1><%= submission.title %></h1>
        </div>
        <dl class="submission-metadata">
          <div><dt>Owner</dt><dd class="submission-owner"><%= submission.ownerLabel %></dd></div>
          <div><dt>Created</dt><dd><time datetime="<%= submission.createdAt %>"><%= displayDate(submission.createdAt) %></time></dd></div>
          <div><dt>Updated</dt><dd><time datetime="<%= submission.updatedAt %>"><%= displayDate(submission.updatedAt) %></time></dd></div>
        </dl>
      </header>

      <% if (flash) { %><p class="submission-notice" role="status"><%= flash %></p><% } %>
      <% if (error) { %><p class="submission-notice is-error" role="alert"><%= error %></p><% } %>
      <% if (submission.status === 'rejected' && submission.rejectionReason) { %>
        <section class="submission-rejection" aria-labelledby="rejection-title"><h2 id="rejection-title">Rejection reason</h2><p><%= submission.rejectionReason %></p></section>
      <% } %>
      <% if (publicationActive) { %>
        <section class="submission-progress" data-publication-refresh data-publication-status="<%= submission.status %>" data-publication-status-url="/admin/submissions/<%= submission.id %>/status" aria-live="polite" aria-labelledby="publication-progress-title">
          <p class="submission-kicker">Background publication</p>
          <h2 id="publication-progress-title" data-publication-summary><%= submission.publicationProgress.summary %></h2>
          <p data-publication-detail><%= submission.publicationProgress.detail %></p>
          <% if (submission.publicationProgress.total !== null) { %>
            <progress
              data-publication-meter
              max="<%= submission.publicationProgress.total %>"
              value="<%= submission.publicationProgress.completed || 0 %>"
              aria-label="Embedding progress"
            ><%= submission.publicationProgress.completed || 0 %> of <%= submission.publicationProgress.total %></progress>
          <% } %>
          <ol class="publication-checkpoints" aria-label="Publication checkpoints">
            <% submission.publicationProgress.checkpoints.forEach(function(checkpoint) { %>
              <li class="checkpoint-<%= checkpoint.status %>">
                <i class="ph <%= checkpoint.status === 'complete' ? 'ph-check-circle' : checkpoint.status === 'active' ? 'ph-circle-notch' : checkpoint.status === 'failed' ? 'ph-warning-circle' : 'ph-circle' %>" aria-hidden="true"></i>
                <span><strong><%= checkpoint.label %></strong><small><%= checkpoint.detail %></small></span>
              </li>
            <% }); %>
          </ol>
          <p class="submission-progress-refresh">Status refreshes automatically. You can safely leave this page.</p>
        </section>
      <% } %>
      <% if (submission.status === 'failed') { %>
        <section class="submission-rejection" aria-labelledby="publication-failure-title">
          <h2 id="publication-failure-title">Publication paused safely</h2>
          <p><%= submission.failureCode === 'embedding_failed'
            ? 'Embedding did not complete, and nothing was activated publicly. Retry when the service is available.'
            : 'The attempt failed and completed its cleanup. Retry to resume from the embedding phase.' %></p>
        </section>
      <% } %>

      <% if (submission.status !== 'deleted') { %>
        <section class="submission-review" aria-labelledby="preview-title">
          <div class="submission-preview-heading">
            <div><p class="submission-kicker">Sanitized preview</p><h2 id="preview-title">Publication candidate</h2></div>
            <% if (submission.status !== 'published') { %><span class="submission-private-marker"><i class="ph ph-lock" aria-hidden="true"></i>Not public</span><% } %>
          </div>
          <div class="submission-preview research-prose"><%- submission.previewHtml %></div>
        </section>
      <% } %>

      <% if (canPublish || canReject || canDelete) { %>
        <section class="admin-decision" aria-labelledby="decision-title">
          <div class="admin-decision-intro">
            <p class="submission-kicker">Server-authorized actions</p>
            <h2 id="decision-title">Review decision</h2>
            <p>Publishing queues embedding first, then commits the public archive and Search documents. The note activates only after both finish.</p>
          </div>

          <% if (canPublish) { %>
            <form class="admin-publish-form" action="/admin/submissions/<%= submission.id %>/publish" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="submission-button" type="submit"><i class="ph ph-check" aria-hidden="true"></i><span><%= submission.failureCode === 'cleanup_required' ? 'Retry publication' : 'Publish submission' %></span></button>
              <p>This returns immediately. Progress continues in the background and is safe to retry after a failure.</p>
            </form>
          <% } %>

          <% if (canReject) { %>
            <form class="submission-form admin-reject-form" action="/admin/submissions/<%= submission.id %>/reject" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="submission-field">
                <label for="rejection-reason">Reason for rejection</label>
                <textarea id="rejection-reason" name="reason" rows="5" maxlength="500" required aria-describedby="rejection-guidance"></textarea>
                <p id="rejection-guidance">Give the owner a concise, actionable reason. Do not include private identity information.</p>
              </div>
              <button class="submission-button is-secondary" type="submit">Reject with reason</button>
            </form>
          <% } %>

          <% if (canDelete) { %>
            <form class="admin-delete-form" action="/admin/submissions/<%= submission.id %>/delete" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div><h3>Delete submission</h3><p>Remove stored submission data and any searchable chunks. This cannot be undone.</p></div>
              <button class="submission-button is-danger" type="submit">Delete permanently</button>
            </form>
          <% } %>
        </section>
      <% } %>
    </main>
    <script src="/javascripts/submission-publication-status.js" defer></script>
  </body>
</html>
