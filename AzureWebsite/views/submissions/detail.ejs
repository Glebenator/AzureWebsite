<%
  var statusLabels = {
    pending: 'Pending',
    ready_for_review: 'Ready for review',
    publishing: 'Publishing',
    published: 'Published',
    rejected: 'Rejected',
    failed: 'Failed',
    deleted: 'Deleted'
  };
  function displayDate(value) {
    if (!value) return 'Date unavailable';
    var date = new Date(value);
    return Number.isNaN(date.getTime()) ? String(value) : new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeStyle: 'short' }).format(date);
  }
  var canEdit = ['pending', 'ready_for_review', 'rejected', 'failed'].includes(submission.status);
  var canDelete = ['pending', 'ready_for_review', 'published', 'rejected', 'failed'].includes(submission.status);
%>
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= description %>">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#faf8f2">
    <title><%= title %></title>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" href="/images/favicon-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/images/favicon-180x180.png" sizes="180x180">
    <link rel="stylesheet" href="/icons/regular/style.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/submissions.css">
  </head>
  <body class="submission-page">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" aria-label="Primary">
      <a class="wordmark" href="/">Gleb Gladyshevskiy</a>
      <div class="submission-header-actions">
        <nav class="primary-nav submission-nav" aria-label="Primary navigation">
          <a class="nav-link" href="/research">Research</a>
          <a class="nav-link is-active" href="/research/submissions" aria-current="page">My submissions</a>
          <% if (isAdmin) { %><a class="nav-link" href="/admin/submissions">Admin</a><% } %>
        </nav>
        <form class="submission-logout" action="/auth/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit">Sign out</button>
        </form>
      </div>
    </header>

    <main id="main-content" class="submission-main">
      <nav class="submission-breadcrumb" aria-label="Breadcrumb">
        <a href="/research/submissions"><i class="ph ph-arrow-left" aria-hidden="true"></i><span>My submissions</span></a>
      </nav>

      <header class="submission-detail-header">
        <div>
          <span class="submission-status status-<%= submission.status %>"><%= statusLabels[submission.status] || submission.status %></span>
          <h1><%= submission.title %></h1>
        </div>
        <dl class="submission-metadata">
          <div><dt>Created</dt><dd><time datetime="<%= submission.createdAt %>"><%= displayDate(submission.createdAt) %></time></dd></div>
          <div><dt>Updated</dt><dd><time datetime="<%= submission.updatedAt %>"><%= displayDate(submission.updatedAt) %></time></dd></div>
        </dl>
      </header>

      <% if (flash) { %><p class="submission-notice" role="status"><%= flash %></p><% } %>
      <% if (error) { %><p class="submission-notice is-error" role="alert"><%= error %></p><% } %>
      <% if (submission.status === 'rejected' && submission.rejectionReason) { %>
        <section class="submission-rejection" aria-labelledby="rejection-title">
          <h2 id="rejection-title">Why this needs changes</h2>
          <p><%= submission.rejectionReason %></p>
        </section>
      <% } %>
      <% if (submission.status === 'published' && submission.slug) { %>
        <p class="submission-notice" role="status">This note is published and available to the research assistant. <a href="/research/<%= submission.slug %>">Read the public note</a>.</p>
      <% } else if (submission.status !== 'deleted') { %>
        <p class="submission-boundary"><i class="ph ph-lock" aria-hidden="true"></i><span>This preview is private and unavailable to public search and assistant retrieval.</span></p>
      <% } %>

      <% if (submission.status !== 'deleted') { %>
        <section class="submission-review" aria-labelledby="preview-title">
          <div class="submission-preview-heading">
            <div><p class="submission-kicker">Sanitized preview</p><h2 id="preview-title">Rendered Markdown</h2></div>
          </div>
          <div class="submission-preview research-prose"><%- submission.previewHtml %></div>
        </section>
      <% } %>

      <% if (canEdit || canDelete) { %>
        <section class="submission-actions" aria-labelledby="submission-actions-title">
          <div>
            <h2 id="submission-actions-title">Manage submission</h2>
            <p>
              <% if (canEdit) { %>Saving changes returns this submission to draft status so you can review it again.<% } %>
              <% if (submission.status === 'published') { %>Deleting also removes the public note and search entry.<% } else { %>Deleting removes the stored Markdown and cannot be undone.<% } %>
            </p>
          </div>
          <div class="submission-action-group">
            <% if (submission.status === 'pending') { %>
              <form action="/research/submissions/<%= submission.id %>/submit" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="submission-button" type="submit">Submit for review</button>
              </form>
            <% } %>
            <% if (canEdit) { %>
              <a class="submission-button is-secondary" href="/research/submissions/<%= submission.id %>/edit">Edit Markdown</a>
              <a class="submission-button is-secondary" href="/research/submissions/<%= submission.id %>/replace">Replace file</a>
            <% } %>
            <% if (canDelete) { %>
              <details class="submission-delete-control">
                <summary class="submission-button is-danger"><%= submission.status === 'published' ? 'Delete and unpublish' : 'Delete submission' %></summary>
                <div class="submission-delete-confirmation">
                  <p>This action is permanent. Confirm only if you want to remove this submission.</p>
                  <form action="/research/submissions/<%= submission.id %>/delete" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="submission-button is-danger" type="submit">Confirm deletion</button>
                  </form>
                </div>
              </details>
            <% } %>
          </div>
        </section>
      <% } %>
    </main>
  </body>
</html>
