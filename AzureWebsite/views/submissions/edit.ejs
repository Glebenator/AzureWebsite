<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= description %>">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#faf8f2">
    <title><%= title %></title>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" href="/images/favicon-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/images/favicon-180x180.png" sizes="180x180">
    <link rel="stylesheet" href="/icons/regular/style.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/submissions.css">
  </head>
  <body class="submission-page">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" aria-label="Primary">
      <a class="wordmark" href="/">Gleb Gladyshevskiy</a>
      <div class="submission-header-actions">
        <nav class="primary-nav submission-nav" aria-label="Primary navigation">
          <a class="nav-link" href="/research">Research</a>
          <a class="nav-link is-active" href="/research/submissions" aria-current="page">My submissions</a>
          <% if (isAdmin) { %><a class="nav-link" href="/admin/submissions">Admin</a><% } %>
        </nav>
        <form class="submission-logout" action="/auth/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit">Sign out</button>
        </form>
      </div>
    </header>

    <main id="main-content" class="submission-main">
      <nav class="submission-breadcrumb" aria-label="Breadcrumb">
        <a href="/research/submissions/<%= submission.id %>"><i class="ph ph-arrow-left" aria-hidden="true"></i><span>Current submission</span></a>
      </nav>

      <header class="submission-page-header">
        <p class="submission-kicker">Edit Markdown</p>
        <h1><%= submission.title %></h1>
        <p>Update the source directly. Saving validates the same UTF-8 Markdown and front matter rules as a file upload, then returns you to a new private preview.</p>
      </header>

      <% if (flash) { %><p class="submission-notice" role="status"><%= flash %></p><% } %>
      <% if (error) { %><p class="submission-notice is-error" role="alert"><%= error %></p><% } %>

      <div class="submission-form-layout submission-editor-layout">
        <form class="submission-form" action="/research/submissions/<%= submission.id %>/edit" method="post" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="submission-field">
            <label for="submission-markdown">Markdown source</label>
            <textarea class="submission-markdown-editor" id="submission-markdown" name="markdown" required spellcheck="false" aria-describedby="markdown-edit-requirements"><%= submission.markdown %></textarea>
            <p id="markdown-edit-requirements">UTF-8 Markdown, up to 3 MiB. Front matter remains part of the source and is revalidated when saved.</p>
          </div>
          <button class="submission-button" type="submit">
            <i class="ph ph-check" aria-hidden="true"></i>
            <span>Save and preview</span>
          </button>
        </form>

        <aside class="submission-guidance" aria-labelledby="edit-effect-title">
          <h2 id="edit-effect-title">What saving does</h2>
          <p>Your current stored version is replaced. The updated version stays private and returns to draft status, even if it was already awaiting review.</p>
        </aside>
      </div>
    </main>
  </body>
</html>
