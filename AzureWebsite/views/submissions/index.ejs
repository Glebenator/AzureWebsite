<%
  var statusLabels = {
    pending: 'Pending',
    ready_for_review: 'Ready for review',
    embedding_pending: 'Embedding pending',
    embedding: 'Embedding',
    publishing: 'Publishing public Markdown',
    published: 'Published',
    rejected: 'Rejected',
    failed: 'Failed',
    deleted: 'Deleted'
  };
  function displayDate(value) {
    if (!value) return 'Date unavailable';
    var date = new Date(value);
    return Number.isNaN(date.getTime()) ? String(value) : new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(date);
  }
%>
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= description %>">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#faf8f2">
    <title><%= title %></title>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" href="/images/favicon-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/images/favicon-180x180.png" sizes="180x180">
    <link rel="stylesheet" href="/icons/regular/style.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/submissions.css">
  </head>
  <body class="submission-page">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" aria-label="Primary">
      <a class="wordmark" href="/">Gleb Gladyshevskiy</a>
      <div class="submission-header-actions">
        <nav class="primary-nav submission-nav" aria-label="Primary navigation">
          <a class="nav-link" href="/research">Research</a>
          <a class="nav-link is-active" href="/research/submissions" aria-current="page">My submissions</a>
          <% if (isAdmin) { %><a class="nav-link" href="/admin/submissions">Admin</a><% } %>
        </nav>
        <form class="submission-logout" action="/auth/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit">Sign out</button>
        </form>
      </div>
    </header>

    <main id="main-content" class="submission-main">
      <header class="submission-page-header submission-page-header-split">
        <div>
          <p class="submission-kicker">Private workspace</p>
          <h1>My submissions</h1>
          <p>Track review status and inspect the same sanitized preview seen by the administrator.</p>
        </div>
        <a class="submission-button" href="/research/submissions/new"><i class="ph ph-upload-simple" aria-hidden="true"></i><span>Submit research</span></a>
      </header>

      <% if (flash) { %><p class="submission-notice" role="status"><%= flash %></p><% } %>
      <% if (error) { %><p class="submission-notice is-error" role="alert"><%= error %></p><% } %>

      <% if (!submissions || submissions.length === 0) { %>
        <section class="submission-empty" aria-labelledby="empty-title">
          <i class="ph ph-file-md" aria-hidden="true"></i>
          <h2 id="empty-title">No submissions yet.</h2>
          <p>Upload one UTF-8 Markdown file to review a private, sanitized preview.</p>
          <a class="text-link" href="/research/submissions/new">Start a submission</a>
        </section>
      <% } else { %>
        <ol class="submission-list">
          <% submissions.forEach(function(submission) { %>
            <li>
              <article class="submission-row">
                <div class="submission-row-main">
                  <span class="submission-status status-<%= submission.status %>"><%= submission.publicationProgress?.publicationLabel || statusLabels[submission.status] || submission.status %></span>
                  <% if (submission.publicationProgress && submission.publicationProgress.publicAvailable) { %><p><strong><%= submission.publicationProgress.aiLabel %></strong></p><% } %>
                  <h2><a href="/research/submissions/<%= submission.id %>"><%= submission.title %></a></h2>
                  <p>Updated <time datetime="<%= submission.updatedAt %>"><%= displayDate(submission.updatedAt) %></time></p>
                  <% if (submission.status === 'rejected' && submission.rejectionReason) { %>
                    <p class="submission-row-reason">Reason: <%= submission.rejectionReason %></p>
                  <% } %>
                </div>
                <div class="submission-row-actions">
                  <a class="text-link" href="/research/submissions/<%= submission.id %>">View preview</a>
                  <% if (submission.status === 'published' && submission.slug) { %>
                    <a class="text-link" href="/research/<%= submission.slug %>">Read published note</a>
                  <% } %>
                </div>
              </article>
            </li>
          <% }); %>
        </ol>
      <% } %>
    </main>
  </body>
</html>
