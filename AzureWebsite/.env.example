# Experimental research harness. This file is guidance; the app does
# not load it automatically. Export values in your local shell or use a private,
# ignored .env file with your preferred development runner.

# Explicit rollout switch. Leave false until the route is intentionally enabled.
EXPERIMENTAL_RESEARCH_ENABLED=false

# Create a key in your OpenRouter account. Never commit or paste a real key here.
OPENROUTER_API_KEY=

# Use openrouter/free or a specific model slug ending in :free.
# The browser picker refreshes current zero-priced :free variants at runtime.
# Free-model availability and rate limits can change without notice.
OPENROUTER_RESEARCH_MODEL=openrouter/free

# Content-free structured stage telemetry is always emitted to application
# stdout when the harness runs. Diagnostic content capture is separate, off by
# default, and refused on production unless an approved private store is
# explicitly injected by application code.
RESEARCH_LAB_DIAGNOSTIC_CAPTURE_ENABLED=false
RESEARCH_LAB_DIAGNOSTIC_CONTENT_ENABLED=false
RESEARCH_LAB_DIAGNOSTIC_DIRECTORY=
